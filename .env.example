# --- runtime ---
# mock: no live SIP or voice sockets (CI / local dry-run)
# live: REGISTER to your SIP provider and bridge RTP to the voice provider
BRIDGE_MODE=mock
# openai | grok | mock — switch provider without other code changes
VOICE_PROVIDER=openai
HTTP_HOST=0.0.0.0
HTTP_PORT=43123
LOG_LEVEL=INFO

# --- Voice: Grok Voice Realtime (required in live mode when VOICE_PROVIDER=grok) ---
# https://console.x.ai/
XAI_API_KEY=
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
XAI_VOICE_MODEL=grok-voice-think-fast-2.0
XAI_VOICE=eve
XAI_TRANSCRIBE_MODEL=grok-transcribe

# --- Voice: OpenAI Realtime (PCMA duplex; set VOICE_PROVIDER=openai) ---
# https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=marin
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- SIP (provider-specific — see docs/providers/) ---
# Reference live path for a cloud/Grok-bot box: docs/providers/ovh.md
#   SIP_REGISTRAR=sip3.ovh.fr          # copy Domain/Registrar from OVH manager
#   SIP_PROXY=                         # outbound proxy if shown and different
#   SIP_DOMAIN=sip3.ovh.fr
#   SIP_USERNAME=0033XXXXXXXXX         # international login, not +E.164
# Residential-only / often blocked from datacenter IPs: docs/providers/voipwise.md
SIP_REGISTRAR=
SIP_PROXY=
SIP_PORT=5060
SIP_TRANSPORT=udp
SIP_DOMAIN=
SIP_USERNAME=
SIP_PASSWORD=
SIP_DISPLAY_NAME=
SIP_LOCAL_HOST=0.0.0.0
# Unprivileged local bind. 5060 needs root.
SIP_LOCAL_PORT=5062
# Public IPv4 in Contact + SDP. Empty = STUN (if set) then local outbound IP.
SIP_ADVERTISE_HOST=
SIP_RTP_PORT_START=40000
SIP_RTP_PORT_END=40100
SIP_CODEC=pcma
SIP_REGISTER_EXPIRES=1800
SIP_USER_AGENT=call-bridge/0.1

# Optional STUN so SDP c= is reachable. Leave STUN_SERVER empty to skip.
STUN_ENABLED=true
STUN_SERVER=
STUN_PORT=3478

TOOL_TIMEOUT_SECONDS=20
HANGUP_GRACE_SECONDS=2.5
MAX_CONCURRENT_CALLS=1
